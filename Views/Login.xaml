
<Window x:Class="LoginMVVM.Views.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       
        xmlns:viewModels="clr-namespace:LoginMVVM.ViewModels"
        Title="Login"
        Height="350"
        Width="400">

    <Window.DataContext>
        <viewModels:LoginViewModel />
    </Window.DataContext>

    <Grid Margin="30"
         Background="{StaticResource BackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Login Title -->
        <TextBlock Grid.Row="0"
                   Text="Login"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,25"/>

        <!-- Username -->
        <TextBlock Grid.Row="1"
                   Text="Username"
                   Margin="0,0,0,5"/>

        <TextBox Grid.Row="2"
                 Height="30"
                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,15"/>

        <!-- Password -->
        <TextBlock Grid.Row="3"
                   Text="Password"
                   Margin="0,0,0,5"/>

        <TextBox Grid.Row="4"
                     Height="30"
                     Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,15"/>

        <!-- Login Button -->
        <Button  Grid.Row="5"
        Width="120"
        Height="40"
        Content="Login"
        Foreground="White"
        Background="{StaticResource PrimaryBrush}"
        BorderThickness="0"
        HorizontalAlignment="Center"
        Command="{Binding LoginCommand}"/>
    </Grid>

</Window>

